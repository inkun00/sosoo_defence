# Server-only public TURN addresses. Empty keeps direct LAN/STUN operation.
# Copy to .env.<Firebase project id>; deploy duelIce again after changing URLs.
# A TURN REST / coturn-compatible service must already exist and be authorized.
TURN_URLS=
# Example: turn:relay.example:3478?transport=udp,turn:relay.example:3478?transport=tcp,turns:relay.example:443?transport=tcp
# Keep TURN_SHARED_SECRET in Firebase Secret Manager, never in this file.
