# Firebase console > Project settings > Your apps > Web app config.
# These are public web-app identifiers; never put a service account key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set true only after account setup and final-record function deployment.
VITE_FIREBASE_AUTH_READY=true
VITE_FIREBASE_RECORDS_READY=true

# Set true after duelRoom and duelPruneRooms are deployed.
VITE_FIREBASE_LOBBY_READY=false
