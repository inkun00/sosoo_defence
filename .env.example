# Firebase console > Project settings > Your apps > Web app config.
# These are public web-app identifiers; never put a service account key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Public Config value, not a secret. Enable after Authentication, Firestore,
# duelRoom, duelSaveResult and duelPruneRooms have been deployed and verified.
VITE_FIREBASE_ENABLED=false
